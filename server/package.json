{
  "name": "campus-connect-hub-auth-server",
  "version": "1.0.0",
  "description": "Local Express Authentication Server for Campus Connect Hub (No External APIs)",
  "main": "auth-server.ts",
  "type": "module",
  "scripts": {
    "start": "node --loader ts-node/esm auth-server.ts",
    "dev": "nodemon --exec node --loader ts-node/esm auth-server.ts",
