# GSFC University Campus Connect Hub — Environment Variables Example
# Public Client Variables (VITE_ prefixed - safe for browser bundle)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Server-Side Only Secrets (Never expose to browser client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# AI Campus Assistant Configuration
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="http://localhost:20128/v1"
OPENAI_MODEL="gemini/gemini-3.8-flash"

# ─── Email Service (Server-Side Only — NEVER use VITE_ prefix) ───────────────
# Option A: Resend (recommended — simple REST API, generous free tier)
# Sign up at https://resend.com and create an API key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Option B: SMTP (Nodemailer — works with Gmail, Brevo, SendGrid, any SMTP server)
# Gmail example: use an App Password (not your main password)
# https://support.google.com/accounts/answer/185833
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
EMAIL_FROM="noreply@example.com"
EMAIL_FROM_NAME="Campus Connect Hub"

# SMS Gateway (for mobile OTP — optional)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
FAST2SMS_API_KEY="your-fast2sms-api-key"
