# ============================================================================
# CAMPUS CONNECT HUB - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this to .env and fill in your actual values.
# NEVER commit .env to version control!
# ============================================================================

# ============================================================================
# CLIENT-SIDE CONFIGURATION (VITE_*)
# These are exposed to the browser. DO NOT put secrets here.
# ============================================================================

# Frontend deployment URL (for CORS and redirects)
FRONTEND_URL="https://campus-connect-hub.vercel.app"

# Supabase project details (public/anon key only - no secrets!)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_your_anon_key_here"

# Auth server URL (where users log in)
VITE_AUTH_SERVER_URL="http://localhost:5001"

# ============================================================================
# SERVER-SIDE CONFIGURATION (private secrets)
# These are NEVER exposed to the browser.
# ============================================================================

# Environment
NODE_ENV="development"

# Supabase service role key (KEEP SECRET - do not expose to client!)
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key_here"

# Database connection string (private)
DATABASE_URL="postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres"

# ============================================================================
# EXTERNAL SERVICES (cloud providers or local services)
# ============================================================================

# AI/LLM Configuration
# For production: use cloud provider (Azure, Anthropic, etc)
# For local: OmniRoute at localhost:20128
OPENAI_API_KEY="sk-your_openai_key_here"
OPENAI_BASE_URL="http://localhost:20128/v1"
OPENAI_MODEL="gemini/gemini-3.8-flash"

# Email service (optional - for notifications)
RESEND_API_KEY="re_your_resend_key_here"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="Campus Connect Hub"

# ============================================================================
# NOTES
# ============================================================================
# - Do NOT use VITE_ prefix for secrets. VITE_ variables are bundled into
#   the frontend JavaScript and exposed to browsers.
# - Use plain environment variable names for server-only secrets.
# - In Vercel, set these in Project Settings → Environment Variables
# - Different environments may need different configs (dev/staging/prod)
# ============================================================================
