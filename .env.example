# GSFC University Campus Connect Hub — Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_your_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key_here"

# Database Connection (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres"

# AI Campus Assistant Configuration
OPENAI_API_KEY="sk-your_openai_key_here"
OPENAI_BASE_URL="http://localhost:20128/v1"
OPENAI_MODEL="gemini/gemini-3.8-flash"

# Email Service — Resend
RESEND_API_KEY="re_your_resend_key_here"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="Campus Connect Hub"
